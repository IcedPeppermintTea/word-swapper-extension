{
    "name": "Word Swapper",
    "description": "Chrome Extension that allows you to swap words in a web page",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
        "tabs",
        "storage"
    ],
    "action": {
        "default_popup": "index.html",
        "default_icon": "assets/favicon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "js/content-script.js"
            ]
        }
    ]
}